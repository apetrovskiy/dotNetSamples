{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch GitlabProjectCreator",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/GitlabProjectCreator/bin/Debug/net8.0/GitlabProjectCreator",
            "args": ["projects001/v1", "prj01", "prj02"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}